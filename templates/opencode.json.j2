{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ ai_default_model }}",
  "experimental": { "disable_paste_summary": true },
  "instructions": ["code-style.md"],
{% if 'codanna' in computer_setup_active_capabilities %}
  "mcp": {
    "codanna": {
      "type": "local",
      "command": ["codanna", "--config", ".codanna/settings.toml", "serve", "--watch"],
      "enabled": true
    }
  },
{% endif %}
  "permission": {
    "bash": {
      "*": "ask",

      "cd": "allow",
      "cd *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "tr": "allow",
      "tr *": "allow",
      "cut": "allow",
      "cut *": "allow",
      "which": "allow",
      "which *": "allow",
      "basename": "allow",
      "basename *": "allow",
      "dirname": "allow",
      "dirname *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "file": "allow",
      "file *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "sleep": "allow",
      "sleep *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "diff": "allow",
      "diff *": "allow",

      "date": "allow",
      "date *": "allow",
      "date *-s*": "deny",
      "date *--set*": "deny",

      "tree": "allow",
      "tree *": "allow",
      "tree *-o*": "deny",

      "find *": "allow",
      "find *-delete*": "deny",
      "find *-exec*": "deny",
      "find *-fprint*": "deny",
      "find *-ok*": "deny",

      "rg *": "allow",
      "rg *--pre*": "deny",
      "rg *--hostname-bin*": "deny",

      "sed *": "allow",
      "sed *-e*": "deny",
      "sed *-f*": "deny",
      "sed *--expression*": "deny",
      "sed *--file*": "deny",

      "sort *": "allow",
      "sort *-o*": "deny",
      "sort *-S*": "deny",

      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git log *--output*": "deny",
      "git show": "allow",
      "git show *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git grep *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git branch *-d*": "deny",
      "git branch *-D*": "deny",
      "git branch *-m*": "deny",
      "git branch *-M*": "deny",
      "git branch *--delete*": "deny",
      "git branch *--force*": "deny",

      "terraform fmt": "allow",
      "terraform fmt *": "allow"
    }
  }
}
