{#
  Shell + Jinja hazard: this script uses bash array-length syntax `${#name[@]}`,
  and Jinja reads `{#` as a comment opener. The body is therefore wrapped in
  {% raw %} blocks, and only the one templated line below sits outside them.
  Keep it that way when editing.
#}
{% raw %}#!/bin/bash
# Checks which local branches have associated PRs that were already merged,
# offers to delete them, then reports branches with unpushed commits.
#
# TARGETS BASH 3.2. macOS ships bash 3.2 as /bin/bash and always will (the
# license changed at 4.0), `bash` is not a managed formula, and this script is
# deployed to ~/.local/bin where it may be invoked from any context — so
# `#!/bin/bash` resolves to 3.2 on a stock machine. Two 3.2 rules apply
# throughout:
#   * no `mapfile`/`readarray` (added in 4.0)
#   * `"${arr[@]}"` on an EMPTY array is an "unbound variable" fatal under
#     `set -u` (fixed in 4.4), so every expansion uses the
#     `${arr[@]+"${arr[@]}"}` guard, which expands to nothing when unset/empty.

set -euo pipefail

# Must be run inside a git repository.
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "Error: not inside a git repository." >&2
  exit 1
fi

# GitHub CLI must be authenticated to query PR status.
if ! gh auth status &>/dev/null; then
  echo "Error: GitHub CLI is not authenticated." >&2
  echo "Run: gh auth login" >&2
  exit 1
fi

# Fetch first so remote-tracking refs are current and, more importantly, so the
# commit objects behind any merged PR's headRefOid are actually present locally
# — the ancestor check below needs them to detect branches merged via GitHub's
# UI "Update branch" button. Non-fatal: an offline run should still work off
# whatever's already in the local object database, just less reliably.
if ! git fetch --prune 2>/dev/null; then
  echo "Warning: git fetch failed, proceeding with local data only." >&2
fi

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null \
  | sed 's@^refs/remotes/origin/@@' || true)
{% endraw %}default_branch=${default_branch:-{{ git_default_branch }}}{% raw %}

# Branches checked out in ANY worktree (including this one) can't be deleted —
# git refuses with "used by worktree at ...". Collect them so they're skipped
# during detection rather than blowing up the delete.
worktree_branches=()
while IFS= read -r _line; do
  case "$_line" in
    branch\ refs/heads/*) worktree_branches+=("${_line#branch refs/heads/}") ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null || true)

# Collect local branches once. (`mapfile` would be the obvious tool; see header.)
branches=()
while IFS= read -r _branch; do
  branches+=("$_branch")
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

if [[ ${#branches[@]} -eq 0 ]]; then
  echo "No local branches found."
  exit 0
fi

echo "Checking local branches for merged PRs..."
echo ""

merged_branches=()

for branch in ${branches[@]+"${branches[@]}"}; do
  # Skip the default branch and anything checked out in a worktree.
  if [[ "$branch" == "$default_branch" || "$branch" == "$current_branch" ]]; then
    continue
  fi
  in_worktree=0
  for _wt in ${worktree_branches[@]+"${worktree_branches[@]}"}; do
    [[ "$branch" == "$_wt" ]] && in_worktree=1 && break
  done
  [[ $in_worktree -eq 1 ]] && continue

  # Look for merged PRs with this branch as head. GitHub matches these by branch
  # NAME, and it remembers the name forever — so a branch that was merged,
  # deleted, and later recreated for a follow-up still matches its old PR. Each
  # row therefore carries the PR's head commit, and we treat the branch as
  # merged when the local tip is that exact commit OR is an ancestor of it.
  # The ancestor case covers PRs updated via GitHub's UI "Update branch" button
  # (merging the base branch in before approval): that adds merge commits
  # directly to the remote PR branch which never get pulled down locally, so
  # the local tip legitimately lags behind headRefOid while still being fully
  # contained in that PR's history. A genuinely reused name won't satisfy
  # either check, since an unrelated PR's commit won't descend from this
  # branch's old tip.
  if ! pr_info=$(gh pr list --head "$branch" --state merged \
    --json number,title,mergedAt,headRefOid \
    --jq '.[] | "\(.headRefOid)\t#\(.number) \(.title) (merged \(.mergedAt | split("T")[0]))"' 2>/dev/null); then
    echo "  ⚠  $branch — failed to query PR status, skipping"
    continue
  fi

  [[ -z "$pr_info" ]] && continue

  local_tip=$(git rev-parse --verify --quiet "refs/heads/$branch") || continue

  matched_pr=""
  while IFS= read -r line; do
    pr_oid=${line%%$'\t'*}
    if [[ "$pr_oid" == "$local_tip" ]]; then
      matched_pr=${line#*$'\t'}
      break
    fi
    if git cat-file -e "${pr_oid}^{commit}" 2>/dev/null \
      && git merge-base --is-ancestor "$local_tip" "$pr_oid" 2>/dev/null; then
      matched_pr=${line#*$'\t'}
      break
    fi
  done <<< "$pr_info"

  if [[ -n "$matched_pr" ]]; then
    merged_branches+=("$branch")
    echo "  🗑  $branch"
    echo "      └─ $matched_pr"
  else
    # Name matches a merged PR but the commits don't — leave it alone.
    echo "  ↻  $branch — matches a merged PR by name, but the local tip differs"
    while IFS= read -r line; do
      echo "      └─ ${line#*$'\t'} (kept, not deleted)"
    done <<< "$pr_info"
  fi
done

echo ""
if [[ ${#merged_branches[@]} -eq 0 ]]; then
  echo "No local branches with merged PRs found."
else
  echo "Found ${#merged_branches[@]} branch(es) with merged PRs."
  read -rp "Delete them all? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    # One at a time: a single failure (e.g. branch checked out elsewhere) must
    # not abort the run under `set -e`. Survivors stay in merged_branches so the
    # unpushed report below still skips them — they are merged either way.
    failed=()
    for branch in ${merged_branches[@]+"${merged_branches[@]}"}; do
      if ! git branch -D "$branch" 2>/dev/null; then
        failed+=("$branch")
        echo "  ⚠  $branch — could not delete"
      fi
    done
    merged_branches=(${failed[@]+"${failed[@]}"})
  else
    echo "Skipped. You can delete them manually with:"
    echo "  git branch -D ${merged_branches[*]}"
  fi
fi

# Report branches with commits that aren't on their remote.
echo ""
echo "Checking for branches with unpushed commits..."
echo ""

unpushed_found=0

for branch in ${branches[@]+"${branches[@]}"}; do
  # Skip branches already flagged as merged (and possibly deleted).
  skip=0
  for merged in ${merged_branches[@]+"${merged_branches[@]}"}; do
    [[ "$branch" == "$merged" ]] && skip=1 && break
  done
  [[ $skip -eq 1 ]] && continue

  # Skip branches that no longer exist (deleted above).
  git show-ref --quiet --verify "refs/heads/$branch" || continue

  if upstream=$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null); then
    ahead=$(git rev-list --count "$upstream".."$branch" 2>/dev/null || echo "0")
    if [[ "$ahead" -gt 0 ]]; then
      unpushed_found=1
      echo "  ⚠  $branch — $ahead unpushed commit(s) vs $upstream"
    fi
  else
    # No upstream tracking branch; compare against the default branch.
    commit_count=$(git rev-list --count "$default_branch".."$branch" 2>/dev/null || echo "0")
    if [[ "$commit_count" -gt 0 ]]; then
      unpushed_found=1
      echo "  ⚠  $branch — no upstream, $commit_count commit(s) ahead of $default_branch"
    fi
  fi
done

if [[ $unpushed_found -eq 0 ]]; then
  echo "All branches are up to date with their remotes."
fi
{% endraw %}