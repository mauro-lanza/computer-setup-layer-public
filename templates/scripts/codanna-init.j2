{#
  Deployed to ~/.local/bin/codanna-init by the `codanna` capability.
  Shell body lives in {% raw %} blocks so bash syntax never meets Jinja;
  only the repository list below is templated. Keep it that way.
#}
{% raw %}#!/bin/bash
# Registers a repository with codanna and indexes it.
# Targets bash 3.2, same constraint as check_merged_branches.

set -euo pipefail

REINDEX=0
{% endraw %}
# The repositories declared by the active layers, baked in at deploy time.
# `active: false` entries are skipped. NOTE: a per-machine
# ~/.config/computer-setup/repositories.yml override is NOT reflected here —
# it resolves inside the `repositories` role, which is tagged `never`.
CODANNA_REPOS=$(cat <<'CODANNA_REPO_LIST'
{% for repo in repositories | default([]) if repo.active | default(true) %}
{{ repo.folder | expanduser }}
{% endfor %}
CODANNA_REPO_LIST
)
{% raw %}
usage() {
  cat <<'EOF'
Usage: codanna-init [--all-repos] [--reindex] [path]

Registers a repository with codanna and builds its index.

  --all-repos   Every repository declared by the computer-setup layers (not a
                filesystem scan). Missing checkouts are skipped.
  --reindex     Rebuild even if an index already exists.
  -h, --help    Show this message.

codanna only parses its 15 supported languages — YAML, HCL, SQL and shell are
not among them, so an infra or dbt repo will index close to nothing.
EOF
}

init_one() {
  local dir="$1"
  local settings="$dir/.codanna/settings.toml"

  [ -f "$settings" ] || ( cd "$dir" && codanna init )

  # `codanna init` leaves `indexed_paths = []` and `codanna index` then exits 1.
  if grep -q '^indexed_paths = \[\]' "$settings"; then
    ( cd "$dir" && codanna add-dir . )
  fi

  # index.meta only appears after a real index; `codanna init` alone already
  # creates .codanna/index/, so the directory itself proves nothing.
  if [ -f "$dir/.codanna/index/index.meta" ] && [ "$REINDEX" -eq 0 ]; then
    echo "==> $dir: already indexed, skipping (use --reindex to rebuild)"
    return 0
  fi

  echo "==> $dir"
  ( cd "$dir" && codanna index --force )
}

ALL_REPOS=0
TARGET=""

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)   usage; exit 0 ;;
    --all-repos) ALL_REPOS=1 ;;
    --reindex)   REINDEX=1 ;;
    -*)          echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)           TARGET="$1" ;;
  esac
  shift
done

if [ "$ALL_REPOS" -eq 1 ]; then
  [ -n "$TARGET" ] && { echo "Error: --all-repos takes no path argument." >&2; exit 2; }
  status=0
  while IFS= read -r repo; do
    [ -n "$repo" ] || continue
    if [ ! -d "$repo/.git" ]; then
      echo "==> $repo: not checked out, skipping"
      continue
    fi
    init_one "$repo" || { echo "!!! $repo: failed" >&2; status=1; }
  done <<EOF
$CODANNA_REPOS
EOF
  exit "$status"
fi

init_one "$(cd "${TARGET:-.}" && pwd)"
{% endraw %}
