# Managed by computer-setup (layer: public) — do not edit manually
# PATH extras + Homebrew settings.
#
# Numbered 00- so PATH is set before any later snippet probes it with
# `command -v` (10-editor resolves $EDITOR that way).
#
# Each iteration PREPENDS, so the resulting order is the REVERSE of the list
# below: ~/.local/bin, then sbin, then bin. That is deliberate — a binary the
# user installed in ~/.local/bin shadows the Homebrew-managed one. Do not
# "fix" the list order.
for _cs_p in {{ homebrew_prefix }}/bin {{ homebrew_prefix }}/sbin "$HOME/.local/bin"; do
  [[ ":$PATH:" != *":$_cs_p:"* ]] && export PATH="$_cs_p:$PATH"
done
unset _cs_p

# Homebrew: disable anonymous analytics collection
export HOMEBREW_NO_ANALYTICS=1
