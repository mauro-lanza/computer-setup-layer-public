{# Python version is DERIVED from homebrew_baseline_formulae, not restated:
   one edit to the formula list moves the alias too. #}
{% set _py = (homebrew_baseline_formulae | select('match', '^python@') | list) %}
{% set _pyver = (_py | first | replace('python@', '')) if _py else '3' %}
# Managed by computer-setup (layer: public) — do not edit manually
alias activate='source ./.venv/bin/activate'
alias setvenv='python{{ _pyver }} -m venv .venv'
