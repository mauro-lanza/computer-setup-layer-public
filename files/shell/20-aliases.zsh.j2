{# The python@X formula in this machine's brew baseline names the interpreter,
   so one edit to that list moves the alias too. Without one (Linux), the
   distribution's python3 is the one on PATH. #}
{% set _py = ((packages_baseline | default({})).brew | default([]) | select('match', '^python@') | list) %}
{% set _pyver = (_py | first | replace('python@', '')) if _py else '3' %}
# Managed by computer-setup (layer: public) — do not edit manually
alias activate='source ./.venv/bin/activate'
alias setvenv='python{{ _pyver }} -m venv .venv'
