{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest"
  },
  "prompt": {
    "paste": "full"
  },
  "tabs": {
    "mode": "off"
  },
  "session": {
    "verbosity": "medium"
  },
  "plugins": [
    {
      "package": "./plugins/context-indicator",
      "options": { "warn": 100000, "alert": 150000 }
    }
  ]
}
